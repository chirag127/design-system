{
	"name": "design-system",
	"version": "0.1.0",
	"private": true,
	"description": "chirag127 design-system monorepo — framework-agnostic tokens, themes, and atomic web components. One package set, a distinct look per site type.",
	"packageManager": "pnpm@10.34.3",
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"build": "pnpm --filter \"./packages/*\" run build",
		"demo:dev": "pnpm --filter @chirag127/demo dev",
		"demo:build": "pnpm run build && pnpm --filter @chirag127/demo build",
		"lint": "biome check .",
		"format": "biome format --write ."
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.8",
		"@types/react": "^19.1.8",
		"tsup": "^8.5.0",
		"typescript": "^5.8.3"
	}
}
