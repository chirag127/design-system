	"license": "MIT",
	"type": "module",
	"main": "./src/index.css",
	"exports": {
		".": "./src/index.css",
		"./base.css": "./src/base.css",
		"./primitives.css": "./src/primitives.css",
		"./editorial.css": "./src/identities/editorial.css",
		"./marketing.css": "./src/identities/marketing.css",
		"./dashboard.css": "./src/identities/dashboard.css",
		"./docs.css": "./src/identities/docs.css",
		"./package.json": "./package.json"
	},
	"files": [
		"src"
	],
	"keywords": [
		"design-tokens",
		"css-variables",
		"theme",
		"design-system",
		"framework-agnostic"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/chirag127/design-system.git",
