{
	"name": "@chirag127/data-firebase",
	"version": "0.2.0",
	"description": "Thin framework-agnostic Firebase Firestore adapter for small user-data. Inits from PUBLIC_FIREBASE_* env, exposes tiny getDoc/setDoc/onSnapshot wrappers. Never hardcodes secrets — config read from env or passed explicitly.",
	"license": "MIT",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"src"
	],
	"scripts": {
		"build": "tsup"
	},
	"keywords": [
		"firebase",
		"firestore",
		"data-adapter",
		"user-data",
		"oriz",
		"design-system",
		"framework-agnostic"
	],
	"peerDependencies": {
		"firebase": ">=11.0.0"
	},
	"peerDependenciesMeta": {
		"firebase": {
			"optional": false
		}
	},
	"devDependencies": {
		"firebase": "^12.17.1",
		"tsup": "^8.5.0",
		"typescript": "^5.8.3"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/chirag127/design-system.git",
		"directory": "packages/data-firebase"
	},
	"publishConfig": {
		"access": "public"
	}
}
