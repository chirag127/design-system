{
  "name": "@chirag127/theme",
  "version": "0.1.0",
  "description": "Ready-to-use framework-agnostic themes built on @chirag127/tokens. Pick an archetype (editorial, marketing, dashboard, docs) and every component — yours or @chirag127/atoms — takes that site's distinct look.",
  "license": "MIT",
  "type": "module",
  "main": "./src/editorial.css",
  "exports": {
    ".": "./src/editorial.css",
    "./editorial.css": "./src/editorial.css",
    "./marketing.css": "./src/marketing.css",
    "./dashboard.css": "./src/dashboard.css",
    "./docs.css": "./src/docs.css",
    "./theme.js": "./src/theme.js",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@chirag127/tokens": "0.1.0"
  },
  "files": [
    "src"
  ],
  "keywords": [
    "theme",
    "css",
    "design-system",
    "web-components",
    "framework-agnostic"
  ]
}
