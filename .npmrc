# npm registry (default for @chirag127/* packages)
registry=https://registry.npmjs.org/

# GitHub Packages registry for @chirag127/* scope (used during publish via CI)
# Set NPM_TOKEN + GITHUB_TOKEN in repo/org secrets.
# Uncomment and set scope to publish to GitHub Packages in addition to npm:
# @chirag127:registry=https://npm.pkg.github.com/

# Provenance — enabled in the release workflow via --provenance flag.
# No extra .npmrc config needed for provenance (handled by npm CLI >=9.5).
