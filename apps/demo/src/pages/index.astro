---
import '@fontsource-variable/inter'
import '@fontsource-variable/inter-tight'
import '@fontsource-variable/source-serif-4'
import '@fontsource-variable/jetbrains-mono'
import '~/styles/demo.css'

const themes = [
  { id: 'editorial', label: 'Editorial', file: '/themes/editorial.css', blurb: 'blogs · long-form · magazines' },
  { id: 'marketing', label: 'Marketing', file: '/themes/marketing.css', blurb: 'saas · landing pages' },
  { id: 'dashboard', label: 'Dashboard', file: '/themes/dashboard.css', blurb: 'apps · analytics' },
  { id: 'docs', label: 'Docs', file: '/themes/docs.css', blurb: 'documentation sites' },
]
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@chirag127 · design system — one set, four identities</title>
    <link id="theme-css" rel="stylesheet" href={themes[0].file} />
    <link rel="stylesheet" href="/themes/atoms.css" />
    <script type="module" src="/themes/theme.js"></script>
  </head>
  <body class="demo-skin">
    <div class="demo-switcher">
      <b>identity</b>
      {
        themes.map((t, i) => (
          <button
            type="button"
            class:list={['demo-sw-btn', { 'is-active': i === 0 }]}
            data-theme-btn={t.id}
            data-file={t.file}
            aria-pressed={i === 0}
          >
            {t.label}
          </button>
        ))
      }
      <span class="demo-sw-spacer"></span>
      <button type="button" id="mode-btn" class="demo-sw-btn">mode: auto</button>
    </div>

    <main class="oz-container">
      <section class="demo-hero">
        <oz-kicker id="hero-kicker">@chirag127/design-system</oz-kicker>
        <h1 class="demo-h">
          One component set.
          <span id="hero-em" class="oz-gradient">Four identities.</span>
        </h1>
        <p class="demo-lead" id="hero-blurb">
          {themes[0].blurb} — every element on this page is the same markup,
          restyled entirely by the theme stylesheet you picked above.
        </p>
        <div class="demo-row">
          <oz-button variant="primary">Primary action</oz-button>
          <oz-button variant="secondary">Secondary</oz-button>
          <oz-button variant="ghost">Ghost</oz-button>
          <oz-button variant="danger">Danger</oz-button>
          <oz-button size="sm">Small</oz-button>
          <oz-button size="lg">Large</oz-button>
        </div>
      </section>

      <section class="demo-section">
        <h2 class="demo-h">Navigation</h2>
        <p class="demo-lead">oz-nav-link — active item highlighted by the theme accent.</p>
        <div class="demo-row">
          <oz-nav-link active href="#top">Overview</oz-nav-link>
          <oz-nav-link href="#components">Components</oz-nav-link>
          <oz-nav-link href="#forms">Forms</oz-nav-link>
          <oz-nav-link href="#prose">Prose</oz-nav-link>
        </div>
      </section>

      <section class="demo-section" id="components">
        <h2 class="demo-h">Cards</h2>
        <p class="demo-lead">oz-card with hoverable elevation; chips and badges ride along.</p>
        <div class="demo-grid">
          <oz-card hoverable>
            <div class="demo-row" style="margin-bottom:0.75rem">
              <oz-chip tone="accent">#astro</oz-chip>
              <oz-badge tone="success">12</oz-badge>
              <oz-badge tone="danger">3</oz-badge>
              <oz-badge>new</oz-badge>
            </div>
            <h3 style="margin:0 0 0.375rem">Analytics pipeline</h3>
            <p style="margin:0;color:var(--oz-ink-mute);font-size:var(--oz-text-base)">
              Cards inherit radius, borders, and surface color from the active identity.
            </p>
          </oz-card>
          <oz-card hoverable>
            <oz-kicker>tutorial</oz-kicker>
            <h3 style="margin:0 0 0.375rem">Deploy to the edge</h3>
            <p style="margin:0;color:var(--oz-ink-mute);font-size:var(--oz-text-base)">
              The same card looks editorial, marketing, dashboard, or docs — zero markup changes.
            </p>
          </oz-card>
          <oz-card hoverable>
            <div class="demo-stats" style="margin-bottom:0.75rem">
              <div class="oz-stat">
                <span class="oz-stat-value">99.9%</span>
                <span class="oz-stat-label">uptime</span>
              </div>
              <div class="oz-stat">
                <span class="oz-stat-value">4×</span>
                <span class="oz-stat-label">faster</span>
              </div>
            </div>
            <h3 style="margin:0">Stats tile flourish</h3>
          </oz-card>
        </div>
      </section>

      <section class="demo-section" id="forms">
        <h2 class="demo-h">Forms</h2>
        <p class="demo-lead">oz-field — labels, inputs, hints, and errors in the theme's voice.</p>
        <div style="max-width:28rem;display:flex;flex-direction:column;gap:1rem">
          <oz-field>
            <label for="f-email">Email address</label>
            <input id="f-email" type="email" placeholder="you@example.com" />
            <span class="oz-hint">We never share your email.</span>
          </oz-field>
          <oz-field>
            <label for="f-name">Display name</label>
            <input id="f-name" type="text" placeholder="Ada Lovelace" />
          </oz-field>
          <div class="demo-row">
            <oz-button variant="primary">Save changes</oz-button>
            <oz-button variant="ghost">Cancel</oz-button>
          </div>
        </div>
      </section>

      <section class="demo-section" id="prose">
        <h2 class="demo-h">Prose</h2>
        <p class="demo-lead">oz-prose — long-form article typography driven by the theme.</p>
        <oz-prose>
          <p>
            The quick brown fox jumps over the lazy dog — the same sentence set in
            a serif editorial face, a grotesk marketing face, or a compact dashboard
            face, depending entirely on the identity you loaded.
          </p>
          <blockquote>A signal quote, set in the theme accent.</blockquote>
          <ul>
            <li>Design tokens are the contract</li>
            <li>Themes are the personality</li>
            <li>Atoms are the vocabulary</li>
          </ul>
          <p>
            Code looks like <code>npm i @chirag127/theme @chirag127/atoms</code> and
            works in <strong>any framework</strong> — no build step required.
          </p>
        </oz-prose>
      </section>
    </main>

    <footer class="demo-footer oz-container">
      @chirag127 · tokens / theme / atoms — framework-agnostic design system
    </footer>

    <script is:inline>
      // Theme switcher — swaps the stylesheet <link> and toggles light/dark.
      const themeLink = document.getElementById('theme-css')
      const blurb = document.getElementById('hero-blurb')
      const em = document.getElementById('hero-em')
      const kicker = document.getElementById('hero-kicker')
      const THEMES = [
        { id: 'editorial', label: 'Editorial', file: '/themes/editorial.css', blurb: 'blogs · long-form · magazines', em: 'Four identities.' },
        { id: 'marketing', label: 'Marketing', file: '/themes/marketing.css', blurb: 'saas · landing pages', em: 'Ship it.' },
        { id: 'dashboard', label: 'Dashboard', file: '/themes/dashboard.css', blurb: 'apps · analytics', em: 'At a glance.' },
        { id: 'docs', label: 'Docs', file: '/themes/docs.css', blurb: 'documentation sites', em: 'Read the docs.' },
      ]
      const buttons = document.querySelectorAll('[data-theme-btn]')
      const setActive = (id) => {
        buttons.forEach((b) => {
          const on = b.dataset.themeBtn === id
          b.classList.toggle('is-active', on)
          b.setAttribute('aria-pressed', String(on))
        })
      }
      buttons.forEach((b) => {
        b.addEventListener('click', () => {
          const t = THEMES.find((x) => x.id === b.dataset.themeBtn)
          if (!t) return
          themeLink.setAttribute('href', t.file)
          blurb.textContent = t.blurb
          em.textContent = t.em
          kicker.textContent = '@chirag127/design-system · ' + t.id
          setActive(t.id)
        })
      })
      const modeBtn = document.getElementById('mode-btn')
      const modeLabel = () => 'mode: ' + (window.ozTheme ? window.ozTheme.get() : 'auto')
      modeBtn.textContent = modeLabel()
      modeBtn.addEventListener('click', () => {
        if (window.ozTheme) window.ozTheme.cycle()
        modeBtn.textContent = modeLabel()
      })
    </script>
  </body>
</html>
